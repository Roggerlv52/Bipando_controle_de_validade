rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isGroupAdmin(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // 1. Usuários
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Grupos
    match /groups/{groupId} {
      // Permite ler se for admin (pelo campo adminId), membro ou busca por código de compartilhamento
      allow read: if isSignedIn() && (
        resource.data.adminId == request.auth.uid ||
        isGroupAdmin(groupId) ||
        isGroupMember(groupId) ||
        resource.data.shareCode != null
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.adminId == request.auth.uid ||
        isGroupAdmin(groupId)
      );

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          isGroupAdmin(groupId) ||
          isOwner(memberId) ||
          memberId == request.auth.uid
        );
      }

      match /products/{productId} {
        allow read, write: if isSignedIn() && (
          isGroupAdmin(groupId) ||
          isGroupMember(groupId)
        );
      }

      match /category/{categoryId} {
        allow read, write: if isSignedIn() && (
          isGroupAdmin(groupId) ||
          isGroupMember(groupId)
        );
      }

      match /invitations/{invitationId} {
        allow read: if isSignedIn() && (
          resource.data.targetUid == request.auth.uid ||
          resource.data.senderId == request.auth.uid ||
          isGroupAdmin(groupId)
        );

        // Validação estrita: O remetente do convite DEVE ser o próprio usuário autenticado
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;

        allow update: if isSignedIn() && (
          resource.data.targetUid == request.auth.uid ||
          isGroupAdmin(groupId)
        );

        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          isGroupAdmin(groupId)
        );
      }
    }

    // 3. Imagens Globais (Catálogo público)
    match /imageProdutos/{barcode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 4. COLLECTION GROUP QUERIES

    match /{path=**}/invitations/{invitationId} {
      allow read: if isSignedIn() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }

    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn();
    }
  }
}
